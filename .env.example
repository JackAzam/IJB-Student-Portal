# Copy this file to .env and replace the values before use.
SECRET_KEY=replace-with-a-long-random-secret
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
# Required only if staff self-registration is enabled.
# For HTTPS tunnel/proxy deployment, set DEBUG=False and configure trusted origins.
CSRF_TRUSTED_ORIGINS=
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=3600
